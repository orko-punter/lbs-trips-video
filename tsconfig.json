{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../lbs-ai-cup/src/*"],
      "lucide-react": ["../lbs-ai-cup/node_modules/lucide-react"]
    }
  },
  "include": ["src", "remotion.config.ts"]
}
